# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND — Environment Variables (Vite)
# NOTE: These are BUILD-TIME variables — they are baked into the JS bundle.
#
# For local dev: copy to .env  →  cp .env.example .env
# For Render:    set as Docker Build Args (not runtime env vars!) in the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────────────────
# Local development (Vite dev server proxies /api automatically):
VITE_BACKEND_URL=/api

# Local dev without Docker (bare-metal):
# VITE_BACKEND_URL=http://localhost:5000/api

# Render / Production — replace with your actual backend Render URL:
# VITE_BACKEND_URL=https://your-backend.onrender.com/api

# ── WebSocket URL ─────────────────────────────────────────────────────────────
# Local development:
VITE_WS_URL=ws://localhost:5000

# Render / Production — replace with your actual backend Render URL:
# VITE_WS_URL=wss://your-backend.onrender.com
