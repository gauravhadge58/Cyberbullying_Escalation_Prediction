# ─────────────────────────────────────────────────────────────────────────────
# ML SERVICE — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Detection Model ───────────────────────────────────────────────────────────
# Controls which transformer model is loaded for toxicity detection.
#
# Presets:
#   light         → martin-ha/toxic-comment-model  (~250MB) ← Render FREE tier
#   full          → unitary/toxic-bert              (~440MB) ← Local / GPU server
#   multilingual  → unitary/multilingual-toxic-xlm-roberta   ← Multi-language
#
# You can also use any raw HuggingFace model ID, e.g:
#   DETECTION_MODEL=distilbert-base-uncased-finetuned-sst-2-english
#
# Render free tier (default — leave as 'light' or omit entirely):
DETECTION_MODEL=light

# Local dev with GPU (uncomment to switch):
# DETECTION_MODEL=full
