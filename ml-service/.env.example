# ─────────────────────────────────────────────────────────────────────────────
# ML SERVICE — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Detection Model ───────────────────────────────────────────────────────────
# Controls which transformer model is loaded for toxicity detection.
#
# Presets:
#   light         → martin-ha/toxic-comment-model  (~250MB) ← Render FREE tier
#   full          → unitary/toxic-bert              (~440MB) ← Local / GPU server
#   multilingual  → unitary/multilingual-toxic-xlm-roberta   ← Multi-language
#
# You can also use any raw HuggingFace model ID, e.g:
#   DETECTION_MODEL=distilbert-base-uncased-finetuned-sst-2-english
#
# Render free tier (default — leave as 'light' or omit entirely):
DETECTION_MODEL=full

# Local dev with GPU (uncomment to switch):
# DETECTION_MODEL=full


# ─────────────────────────────────────────────────────────────────────────────
# LangChain Moderation & Reasoning Layer
# ─────────────────────────────────────────────────────────────────────────────

# Master switch — set to "false" to disable LangChain entirely
# (the BERT → BiLSTM → RF pipeline always runs regardless of this flag)
LANGCHAIN_ENABLED=true

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: groq | openai | ollama
# Groq is recommended — it's FREE and very fast (~0.5s response)
LLM_PROVIDER=groq

# ── Model Name ────────────────────────────────────────────────────────────────
# Groq models:  llama3-8b-8192 | llama3-70b-8192 | mixtral-8x7b-32768
# OpenAI models: gpt-3.5-turbo | gpt-4o-mini
# Ollama models: llama3 | mistral | phi4
LLM_MODEL=llama3-8b-8192

# ── Groq API Key (FREE — get from https://console.groq.com) ──────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── OpenAI API Key (optional — only needed if LLM_PROVIDER=openai) ───────────
OPENAI_API_KEY=

# ── Ollama Base URL (optional — only needed if LLM_PROVIDER=ollama) ──────────
OLLAMA_BASE_URL=http://localhost:11434
