# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Docker Compose (local dev) — uses 'mongo' service name as hostname:
MONGODB_URI=mongodb://mongo:27017/cyberbullying

# Bare-metal local dev (no Docker):
# MONGODB_URI=mongodb://localhost:27017/cyberbullying

# Render / Production — use MongoDB Atlas free cluster:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/cyberbullying?retryWrites=true&w=majority

# ── ML Service URL ────────────────────────────────────────────────────────────
# Docker Compose (local dev) — uses 'ml-service' service name as hostname:
ML_URL=http://ml-service:8000

# Bare-metal local dev (no Docker):
# ML_URL=http://localhost:8000

# Render / Production — replace with your actual ml-service Render URL:
# ML_URL=https://your-ml-service.onrender.com

# ── Groq AI Chatbot ───────────────────────────────────────────────
# Required for the CERDS-AI chatbot feature (uses Llama 3 70B via Groq).
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
