# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Server port (Render sets this automatically, keep 5000 for local)
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local development:
MONGODB_URI=mongodb://localhost:27017/cyberbullying_db

# Render / Production — use MongoDB Atlas free cluster:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/cyberbullying?retryWrites=true&w=majority

# ── ML Service URL ────────────────────────────────────────────────────────────
# Local development (Docker Compose):
ML_URL=http://ml-service:8000

# Local development (bare-metal, no Docker):
# ML_URL=http://localhost:8000

# Render / Production — replace with your actual ml-service Render URL:
# ML_URL=https://your-ml-service.onrender.com
